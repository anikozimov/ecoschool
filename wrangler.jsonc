{
  // Cloudflare Workers — statik fayllar (Static Assets) sifatida joylash.
  // Sayt brauzerda ishlaydi va Supabase'ga to'g'ridan-to'g'ri ulanadi, server kodi kerak emas.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eco-school",
